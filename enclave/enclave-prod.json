{
    "exe": "enclave",
    "key": "private.pem",
    "debug": false,
    "heapSize": 512,
    "productID": 1,
    "securityVersion": 1,
    "mounts": [
        {
            "source": "/tmp",
            "target": "/tmp",
            "type": "hostfs",
            "readOnly": false
        }
    ],
    "env": [
        {
            "name": "HOME",
            "fromHost": true
        }
    ]
}
