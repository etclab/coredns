{
    "exe": "enclave",
    "key": "private.pem",
    "debug": true,
    "heapSize": 512,
    "productID": 1,
    "securityVersion": 1,
    "mounts": [
        {
            "source": "/tmp",
            "target": "/tmp",
            "type": "hostfs",
            "readOnly": false
        }
    ],
    "env": [
        { "name": "HOME", "fromHost": true },
        { "name": "CODOH_CACHE_SIZE", "fromHost": true },
        { "name": "CODOH_USE_ORAM", "fromHost": true },
        { "name": "CODOH_ORAM_BLOCK_SIZE", "fromHost": true },
        { "name": "CODOH_PAD_BUCKETS", "fromHost": true },
        { "name": "CODOH_REPLAY_DELTA_SECS", "fromHost": true },
        { "name": "CODOH_WARMUP_THRESHOLD", "fromHost": true },
        { "name": "CODOH_OMISSION_THRESHOLD", "fromHost": true },
        { "name": "CODOH_OUTSTANDING_TTL_SECS", "fromHost": true },
        { "name": "CODOH_BATCH_SIZE", "fromHost": true },
        { "name": "CODOH_BATCH_COMMIT_PROB", "fromHost": true },
        { "name": "CODOH_QUEUE_MAX_SIZE", "fromHost": true },
        { "name": "CODOH_TARGET_SIGNING_PUBKEY", "fromHost": true }
    ]
}
